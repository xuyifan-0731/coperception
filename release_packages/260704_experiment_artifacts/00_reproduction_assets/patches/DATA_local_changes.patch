+             np.ones((lidar_projected.shape[0], 1), dtype=lidar_projected.dtype)],
+            axis=1,
+        )
+        lidar_projected[:, :3] = np.dot(xyz1, transform.T)[:, :3]
+        return lidar_projected
+
