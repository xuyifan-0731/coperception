+
+        scene_info = self.dataset_info_pkl[idx]
+        prev_samples = scene_info.get('prev_samples', {})
+        prev_token = prev_samples.get(delay, None)
+        if prev_token is not None and prev_token in self.sample_token_to_index:
+            return self.sample_token_to_index[prev_token]
+
+        scene_id = scene_info.get('scene_id', scene_info.get('scene_token', 0))
+        indices = self.scene_to_indices.get(scene_id, [idx])
+        pos = self.index_position_in_scene.get(idx, 0)
+        return indices[max(0, pos - delay)]
