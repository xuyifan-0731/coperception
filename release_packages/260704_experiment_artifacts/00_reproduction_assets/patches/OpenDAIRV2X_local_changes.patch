+class TrainedMotionCompensator:
+    def __init__(self, model_path):
+        if not model_path:
+            raise ValueError("--time-compensation-method ours requires --ours-compensation-model")
+        self.rf_estimator = None
+        if str(model_path).endswith(".pkl"):
