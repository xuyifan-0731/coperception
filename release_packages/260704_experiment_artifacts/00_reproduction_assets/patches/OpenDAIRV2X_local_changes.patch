+def transform_and_filter_pred(id, timestamp, raw_pred, trans, pred_filter):
+    box = np.array(raw_pred["boxes_3d"], dtype=np.float64)
+    arrows = np.array(raw_pred["arrows"], dtype=np.float64)
+    box_center = arrows[:, 0:1, :]
+    arrow_ends = arrows[:, 1:2, :]
+    score = np.array(raw_pred["scores_3d"])
+    label = np.array(raw_pred["labels_3d"])
+
+    if trans is not None:
+        box = trans(box)
+        box_center = trans(box_center[:, 0, :])[:, np.newaxis, :]
+        arrow_ends = trans(arrow_ends[:, 0, :])[:, np.newaxis, :]
+
+    remain = []
+    if not (len(label) == 1 and label[0] == -1):
+        for i in range(box.shape[0]):
+            if pred_filter(box[i]):
+                remain.append(i)
+
+    if len(remain) >= 1:
+        box = box[remain]
+        box_center = box_center[remain]
+        arrow_ends = arrow_ends[remain]
+        score = score[remain]
+        label = label[remain]
+    else:
+        box = np.zeros((1, 8, 3))
+        box_center = np.zeros((1, 1, 3))
+        arrow_ends = np.zeros((1, 1, 3))
+        label = np.zeros((1))
+        score = np.zeros((1))
+
+    return gen_pred_dict(
+        id,
+        timestamp,
+        box,
+        np.concatenate([box_center, arrow_ends], axis=1),
+        np.array([]),
