+                self.rf_estimator.verbose = 0
+            if hasattr(self.rf_estimator, "n_jobs"):
+                self.rf_estimator.n_jobs = 1
+        else:
+            data = np.load(model_path, allow_pickle=False)
+            metadata_raw = str(data["metadata"]) if "metadata" in data.files else "{}"
+            self.metadata = json.loads(metadata_raw)
+            self.model_kind = self.metadata.get("model_kind", "ridge")
+            self.weights = data["weights"].astype(np.float64) if "weights" in data.files else None
+            self.layers = []
+            layer_idx = 0
+            while f"layer{layer_idx}_weight" in data.files:
+                self.layers.append(
+                    (
+                        data[f"layer{layer_idx}_weight"].astype(np.float64),
+                        data[f"layer{layer_idx}_bias"].astype(np.float64),
+                    )
+                )
+                layer_idx += 1
+            self.mean = data["mean"].astype(np.float64)
+            self.std = data["std"].astype(np.float64)
+        self.model_path = model_path
+        self.history_frames = int(self.metadata.get("history_frames", self._infer_history_frames(self.mean.shape[0])))
+
+    @staticmethod
+    def _infer_history_frames(feature_dim):
+        if feature_dim >= 26 and (feature_dim - 21) % 5 == 0:
+            return max(int((feature_dim - 21) // 5) + 1, 2)
+        return 2
+
+    @staticmethod
+    def _box_geometry(boxes):
+        if len(boxes) == 0:
+            return (
+                np.zeros((0, 3), dtype=np.float64),
+                np.zeros((0, 3), dtype=np.float64),
+                np.zeros((0,), dtype=np.float64),
+            )
+        boxes = boxes.astype(np.float64)
+        center = np.mean(boxes, axis=1)
+        size = np.zeros((boxes.shape[0], 3), dtype=np.float64)
+        yaw = np.zeros((boxes.shape[0],), dtype=np.float64)
+        size[:, 2] = np.max(boxes[:, :, 2], axis=1) - np.min(boxes[:, :, 2], axis=1)
+        for i, box in enumerate(boxes):
+            xy = box[:, :2] - center[i, :2]
+            cov = xy.T @ xy
+            vals, vecs = np.linalg.eigh(cov)
+            main_axis = vecs[:, int(np.argmax(vals))]
+            side_axis = np.array([-main_axis[1], main_axis[0]], dtype=np.float64)
+            ext_main = xy @ main_axis
+            ext_side = xy @ side_axis
+            length = float(ext_main.max() - ext_main.min())
+            width = float(ext_side.max() - ext_side.min())
+            if width > length:
+                length, width = width, length
+            size[i, 0] = length
+            size[i, 1] = width
+            yaw[i] = np.arctan2(float(main_axis[1]), float(main_axis[0]))
+        return center, size, yaw
+
+    @staticmethod
+    def _valid_box_mask(frame):
+        if frame.num_boxes == 0:
+            return np.zeros((0,), dtype=bool)
+        score = frame.confidence
+        label = frame.label
+        boxes = frame.boxes
+        mask = np.ones((frame.num_boxes,), dtype=bool)
+        if score is not None:
+            mask &= np.asarray(score, dtype=np.float64) > 0.0
+        if label is not None:
+            mask &= np.asarray(label) >= 0
+        mask &= np.linalg.norm(boxes.reshape(frame.num_boxes, -1), axis=1) > 1e-6
+        return mask
+
+    @staticmethod
+    def _features(frame, horizon_frames):
+        n = frame.num_boxes
+        if n == 0:
+            return np.zeros((0, 18), dtype=np.float64)
+        center, size, yaw = TrainedMotionCompensator._box_geometry(frame.boxes)
+        size = np.clip(size.astype(np.float64), 1e-3, None)
+        h = np.full((n, 1), float(horizon_frames), dtype=np.float64)
+        base = np.concatenate(
+            [
+                center[:, :2],
+                center[:, 2:3],
+                size,
+                np.sin(2.0 * yaw)[:, None],
+                np.cos(2.0 * yaw)[:, None],
+                h,
+            ],
+            axis=1,
+        )
+        xy_h = base[:, [0, 1]] * h
+        h2 = h * h
+        inv_size = 1.0 / size[:, :2]
+        return np.concatenate([base, xy_h, h2, base[:, :2] ** 2, base[:, 3:5] ** 2, inv_size], axis=1)
+
+    @staticmethod
+    def _history_features(frame, prev_frames, prev_time_diffs, target_time_diff, horizon_frames, prefix, history_frames):
+        base = TrainedMotionCompensator._features(frame, horizon_frames)
+        n = frame.num_boxes
+        if n == 0:
+            return np.zeros((0, 21 + 5 * max(int(history_frames) - 1, 0)), dtype=np.float64)
+        history_slots = max(int(history_frames) - 1, 0)
+        hist_delta = np.zeros((n, history_slots * 2), dtype=np.float64)
+        temporal_delta = np.zeros((n, history_slots * 2), dtype=np.float64)
+        has_prev = np.zeros((n, history_slots), dtype=np.float64)
+        if history_slots:
+            cur_valid = TrainedMotionCompensator._valid_box_mask(frame)
+            cur_idx = np.where(cur_valid)[0]
+            cur_centers = frame.center[cur_idx, :2] if len(cur_idx) else np.zeros((0, 2), dtype=np.float64)
+            cur_labels = np.asarray(frame.label)[cur_idx] if len(cur_idx) else np.zeros((0,), dtype=np.float64)
+            for slot in range(history_slots):
+                if slot >= len(prev_frames) or slot >= len(prev_time_diffs):
+                    continue
+                prev_frame = prev_frames[slot]
+                prev_time_diff = prev_time_diffs[slot]
+                if (
+                    prev_frame is None
+                    or prev_frame.num_boxes == 0
+                    or prev_time_diff is None
+                    or float(prev_time_diff) <= 0
+                    or len(cur_idx) == 0
+                ):
+                    continue
+                prev_valid = TrainedMotionCompensator._valid_box_mask(prev_frame)
+                prev_idx = np.where(prev_valid)[0]
+                if len(prev_idx) == 0:
+                    continue
+                prev_centers = prev_frame.center[prev_idx, :2]
+                dist = np.linalg.norm(prev_centers[:, None, :] - cur_centers[None, :, :], axis=2)
+                prev_labels = np.asarray(prev_frame.label)[prev_idx]
+                dist[prev_labels[:, None] != cur_labels[None, :]] = 1e6
+                rows, cols = [], []
+                used_prev = set()
+                used_cur = set()
+                flat_order = np.argsort(dist, axis=None)
+                for flat in flat_order:
+                    row, col = np.unravel_index(int(flat), dist.shape)
+                    if dist[row, col] > 8.0:
+                        break
+                    if row in used_prev or col in used_cur:
+                        continue
+                    used_prev.add(row)
+                    used_cur.add(col)
+                    rows.append(row)
+                    cols.append(col)
+                if not rows:
+                    continue
+                dst = cur_idx[np.asarray(cols, dtype=np.int64)]
+                src = prev_idx[np.asarray(rows, dtype=np.int64)]
+                delta = frame.center[dst, :2] - prev_frame.center[src, :2]
+                hist_delta[dst, slot * 2 : slot * 2 + 2] = delta
+                temporal_delta[dst, slot * 2 : slot * 2 + 2] = delta * (
+                    float(target_time_diff) / max(float(prev_time_diff), 1e-6)
+                )
+                has_prev[dst, slot] = 1.0
+        score = np.zeros((n, 1), dtype=np.float64)
+        if frame.confidence is not None:
+            score[:, 0] = np.asarray(frame.confidence, dtype=np.float64)
+        label = np.zeros((n, 1), dtype=np.float64)
+        if frame.label is not None:
+            label[:, 0] = np.asarray(frame.label, dtype=np.float64)
+        side = np.full((n, 1), 1.0 if prefix == "veh" else 0.0, dtype=np.float64)
+        return np.concatenate([base, hist_delta, temporal_delta, has_prev, score, label, side], axis=1)
+
+    def compensate(self, frame, horizon_frames):
+        if frame.num_boxes == 0 or horizon_frames <= 0:
+            return np.zeros((frame.num_boxes, 2), dtype=np.float64)
+        valid = self._valid_box_mask(frame)
+        if not np.any(valid):
+            return np.zeros((frame.num_boxes, 2), dtype=np.float64)
+        x_all = self._features(frame, horizon_frames)
+        x = (x_all[valid] - self.mean) / self.std
+        if self.model_kind == "rf":
+            pred = self.rf_estimator.predict(x)
+        elif self.model_kind == "mlp":
+            out = x
+            for layer_idx, (weight, bias) in enumerate(self.layers):
+                out = out @ weight.T + bias
+                if layer_idx < len(self.layers) - 1:
+                    out = np.maximum(out, 0.0)
+            pred = out
+        else:
+            xb = np.concatenate([np.ones((x.shape[0], 1), dtype=x.dtype), x], axis=1)
+            pred = xb @ self.weights
+        offset = np.zeros((frame.num_boxes, 2), dtype=np.float64)
+        offset[valid] = pred
+        return offset
+
+    def compensate_history(self, frame, prev_frames, prev_time_diffs, target_time_diff, horizon_frames, prefix):
+        if frame.num_boxes == 0 or horizon_frames <= 0:
+            return np.zeros((frame.num_boxes, 2), dtype=np.float64)
+        valid = self._valid_box_mask(frame)
+        if not np.any(valid):
+            return np.zeros((frame.num_boxes, 2), dtype=np.float64)
+        if prev_frames is None or not isinstance(prev_frames, list):
+            prev_frames = [] if prev_frames is None else [prev_frames]
+        if prev_time_diffs is None or not isinstance(prev_time_diffs, list):
+            prev_time_diffs = [] if prev_time_diffs is None else [prev_time_diffs]
+        x_all = self._history_features(
+            frame,
+            prev_frames,
+            prev_time_diffs,
+            target_time_diff,
+            horizon_frames,
+            prefix,
+            self.history_frames,
+        )
+        x = (x_all[valid] - self.mean) / self.std
+        if self.model_kind == "rf":
+            pred = self.rf_estimator.predict(x)
+        elif self.model_kind == "mlp":
+            out = x
+            for layer_idx, (weight, bias) in enumerate(self.layers):
+                out = out @ weight.T + bias
+                if layer_idx < len(self.layers) - 1:
+                    out = np.maximum(out, 0.0)
+            pred = out
+        else:
+            xb = np.concatenate([np.ones((x.shape[0], 1), dtype=x.dtype), x], axis=1)
+            pred = xb @ self.weights
+        offset = np.zeros((frame.num_boxes, 2), dtype=np.float64)
+        offset[valid] = pred
+        return offset
 
 
