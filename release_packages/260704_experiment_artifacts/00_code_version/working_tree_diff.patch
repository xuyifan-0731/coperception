+    )
+    parser.add_argument("--weight-decay", type=float, default=1e-2)
+    parser.add_argument("--max-ego-delay-ms", type=int, default=400)
+    parser.add_argument("--max-agent-delay-ms", type=int, default=900)
+    parser.add_argument(
+        "--ego-delay-train-choices",
+        default="",
