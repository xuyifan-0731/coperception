+                    )
+            if step >= args.max_steps:
+                break
+    torch.save(
+        {
+            "state_dict": comp.state_dict(),
+            "hidden_channels": args.hidden_channels,
+            "max_total_delay": args.max_total_delay,
+            "residual_scale": args.residual_scale,
+            "gate_init": args.gate_init,
