+        ("不同时延 + SyncNet 补偿", "SyncNet w/ Comp."),
+    ]
+    for marker in ["#### 1.1.1 AP@0.5", "#### 1.1.2 AP@0.7"]:
+        lines = replace_paper_table(lines, marker, paper_methods_v2v)
