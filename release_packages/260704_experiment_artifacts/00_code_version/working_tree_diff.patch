+class SafeCollate:
+    def __init__(self, dataset):
+        self.dataset = dataset
+
+    def __call__(self, batch):
+        try:
+            return self.dataset.collate_batch(batch)
+        except (KeyError, ValueError, RuntimeError) as exc:
+            return {"__skip__": True, "__skip_reason__": repr(exc)}
