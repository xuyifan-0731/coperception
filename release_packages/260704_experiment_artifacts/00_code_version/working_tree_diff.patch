+                    f"step={global_step} epoch={epoch} loss={last['total']:.4f} "
+                    f"cls={last['cls']:.4f} loc={last['loc']:.4f} pos={last['pos']:.0f} gate={gate:.6f}",
+                    flush=True,
+                )
