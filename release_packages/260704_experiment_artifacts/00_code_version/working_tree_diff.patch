+def apply_dair_official_total_delay_projection(tables: list[Table]) -> set[int]:
+    """Project DAIR official k-delay runs onto the Comm/Comp grid.
+
+    OpenDAIRV2X official logs in this repo expose a single async delay k, not
+    separate communication and computation delays. For cells where an official
+    run exists at k=comm_delay+comp_delay, we can still report an explicit
+    total-delay projection. Missing k values remain unavailable until the
+    official eval is run for those delays.
+    """
+
+    changed: set[int] = set()
+    path = REPO_ROOT / "results" / "dair_v2x" / "tables" / "official_baselines_table.csv"
+    rows = read_csv(path)
+    if not rows:
+        return changed
+    lookup = {row["run"]: row for row in rows}
+
+    specs = [
+        ("2.1.1", "car_bev_ap_0_50"),
+        ("2.1.2", "car_bev_ap_0_70"),
+    ]
+    methods = [
+        ("不同时延无补偿", "Late fusion w/o comp.", "late_fusion_no_comp", (2, 4)),
+        ("不同时延 + TCLF 补偿", "Late fusion + TCLF", "late_fusion_tclf", (2, 4)),
+    ]
+
+    for table_id, metric in specs:
+        for category, method, prefix, comps in methods:
+            for comp in comps:
+                values: dict[int, float] = {}
+                for comm in range(6):
+                    total_delay = comp + comm
+                    row = lookup.get(official_run_key(prefix, total_delay))
+                    if row and row.get(metric):
+                        values[comm] = float(row[metric])
+                if not values:
+                    continue
+                for table_idx, table in enumerate(tables):
+                    if table.table_id != table_id:
+                        continue
+                    before = [list(r) for r in table.rows]
+                    for comm, value in values.items():
+                        set_cell(
+                            [table],
+                            table_id=table_id,
+                            category=category,
+                            method=method,
+                            comp=comp,
+                            column=f"Comm{comm}",
+                            value=fmt_percent(value),
+                        )
+                    set_cell(
+                        [table],
+                        table_id=table_id,
+                        category=category,
+                        method=method,
+                        comp=comp,
+                        column="AVG",
+                        value=fmt_percent(sum(values.values()) / len(values)),
+                    )
+                    if table.rows != before:
+                        changed.add(table_idx)
+    return changed
+
+
