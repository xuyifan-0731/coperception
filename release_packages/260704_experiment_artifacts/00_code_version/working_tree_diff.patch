+def clean_tex_cell(cell: str) -> str:
+    cell = cell.strip()
+    cell = cell.replace(r"\textendash", "-")
+    cell = cell.replace(r"\%", "%")
+    for command in ("textbf", "textit", "small"):
+        cell = re.sub(rf"\\{command}\{{([^{{}}]*)\}}", r"\1", cell)
+    cell = re.sub(r"\\[a-zA-Z]+\*?(?:\[[^\]]*\])?(?:\{[^{}]*\})*", "", cell)
+    return cell.strip().strip("{}").strip()
+
+
+def parse_latency_tex_table(path: Path) -> dict[str, dict[int, dict[str, list[float]]]]:
+    """Parse local LaTeX latency tables with AP@0.5/AP@0.7 blocks.
+
+    The source files use one method column, one Comp column, then 7 AP@0.5
+    values and 7 AP@0.7 values: AVG, Comm0, ..., Comm5.
+    """
+
+    if not path.exists():
+        return {}
+
+    rows: dict[str, dict[int, dict[str, list[float]]]] = {}
+    current_method = ""
+    for raw_row in path.read_text(encoding="utf-8").split(r"\\"):
+        if "&" not in raw_row:
+            continue
+        raw_cells = raw_row.split("&")
+        cells = [clean_tex_cell(cell) for cell in raw_cells]
+        if len(cells) < 16:
+            continue
+
+        method = f"{raw_cells[0]} {cells[0]}"
+        method_match = re.search(r"(Oracle|No Collaboration|V2VNet|Ours|SyncNet w/ Comp\.|SyncNet|DiscoNet)", method)
+        if method_match:
+            current_method = method_match.group(1)
+        if not current_method:
+            continue
+
+        comp_cell = clean_tex_cell(cells[1])
+        if comp_cell not in {"0", "2", "4"}:
+            continue
+
+        numeric_values: list[float] = []
+        for cell in cells[2:16]:
+            number_match = re.search(r"-?\d+(?:\.\d+)?", cell)
+            if not number_match:
+                break
+            numeric_values.append(float(number_match.group(0)))
+        if len(numeric_values) != 14:
+            continue
+
+        comp = int(comp_cell)
+        rows.setdefault(current_method, {})[comp] = {
+            "AP@0.5": numeric_values[:7],
+            "AP@0.7": numeric_values[7:],
+        }
+    return rows
+
