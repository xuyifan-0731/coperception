+            "unfreeze_data_modules": args.unfreeze_data_modules,
+            "data_lr": args.data_lr,
+            "data_weight_decay": args.data_weight_decay,
+            "data_model_state": model.state_dict() if data_params else None,
+        },
+        args.ckpt,
